generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String           @unique
  passwordHash    String
  role            String           @default("USER")
  lastActiveAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  dailyReports    DailyReport[]
  employeeProfile EmployeeProfile?
  tasks           EmployeeTask[]

  @@index([role])
  @@index([lastActiveAt])
}


model EmployeeProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  department String?
  position   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmployeeTask {
  id          String         @id @default(cuid())
  employeeId  String
  title       String
  description String?
  status      String         @default("TODO")
  deadline    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  employee    User           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workLogs    WorkLogEntry[]

  @@index([status])
  @@index([updatedAt])
}

model DailyReport {
  id            String              @id @default(cuid())
  employeeId    String
  date          DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  employee      User                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  routineChecks DailyRoutineCheck[]
  workLogs      WorkLogEntry[]

  @@unique([employeeId, date])
  @@index([date])
}

model WorkLogEntry {
  id            String        @id @default(cuid())
  dailyReportId String
  taskId        String?
  description   String
  minutes       Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  task          EmployeeTask? @relation(fields: [taskId], references: [id])
  dailyReport   DailyReport   @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
}

model RoutineItem {
  id        String              @id @default(cuid())
  key       String              @unique
  label     String
  sortOrder Int                 @default(0)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  checks    DailyRoutineCheck[]
}

model DailyRoutineCheck {
  id            String      @id @default(cuid())
  dailyReportId String
  routineItemId String
  checked       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  routineItem   RoutineItem @relation(fields: [routineItemId], references: [id], onDelete: Cascade)
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  @@unique([dailyReportId, routineItemId])
}
